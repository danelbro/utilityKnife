{
    "version": 3,
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "Debug",
            "description": "Debug configuration with Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "Release",
            "displayName": "Release",
            "description": "Release configuration with Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "RelWithDebInfo",
            "displayName": "RelWithDebInfo",
            "description": "RelWithDebInfo configuration with Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "Termux base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Linux",
	            "SDL_KMSDRM": "OFF",
	            "CMAKE_C_FLAGS": "-U__ANDROID__",
	            "CMAKE_CXX_FLAGS": "-U__ANDROID__",
	            "CMAKE_EXE_LINKER_FLAGS": "-landroid-shmem",
                "CMAKE_SHARED_LINKER_FLAGS": "-landroid-shmem"
            }
        },
        {
            "name": "tmx_Debug",
            "displayName": "Debug (Termux)",
            "description": "Default debug build for Termux",
            "inherits": "Termux base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "DEBUG" }
        },
        {
            "name": "tmx_Release",
            "displayName": "Release (Termux)",
            "description": "Default release build for Termux",
            "inherits": "Termux base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "MSVC",
            "description": "Target Windows (64-bit) with the Visual Studio development environment.",
            "displayName": "MSVC",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "displayName": "Debug",
            "configurePreset": "Debug",
            "description": "Default debug build",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "Release",
            "displayName": "Release",
            "configurePreset": "Release",
            "description": "Default release build",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "RelWithDebInfo",
            "displayName": "RelWithDebInfo",
            "configurePreset": "RelWithDebInfo",
            "description": "Default RelWithDebInfo build",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "tmx_Debug",
            "displayName": "Debug (Termux)",
            "configurePreset": "tmx_Debug",
            "description": "Termux debug build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        },
        {
            "name": "tmx_Release",
            "displayName": "Release (Termux)",
            "configurePreset": "tmx_Release",
            "description": "Termux release build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Android"
            }
        }
    ]
}
